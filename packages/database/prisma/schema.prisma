datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  BURSAR
  TEACHER
  PARENT
  STUDENT
}

enum CurriculumType {
  NIGERIAN
  BRITISH
  HYBRID
}

enum Term {
  FIRST_TERM
  SECOND_TERM
  THIRD_TERM
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role            @default(STUDENT)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      StudentProfile?
  staffProfile StaffProfile?
}

model StudentProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  admissionNumber String         @unique
  curriculum      CurriculumType @default(HYBRID)
  currentClass    String         // e.g., "JSS 2" or "Year 8"
  guardianName    String
  guardianPhone   String
  grades          GradeRecord[]
  attendance      Attendance[]
  fees            FeeRecord[]
}

model StaffProfile {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
  staffId    String @unique
  department String
}

model GradeRecord {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  subject        String
  term           Term
  session        String         // e.g., "2026/2027"
  caScore        Float?         // Continuous Assessment (e.g., Nigerian 40%)
  examScore      Float?         // Exam Score (e.g., Nigerian 60%)
  britishGrade   String?        // e.g., "A*", "B", or Checkpoint level
  curriculumType CurriculumType
  createdAt      DateTime       @default(now())
}

model Attendance {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  date      DateTime       @default(now())
  isPresent Boolean        @default(true)
  term      Term
}

model FeeRecord {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  totalAmount Float
  amountPaid  Float          @default(0)
  term        Term
  session     String
  isCleared   Boolean        @default(false)
  gatewayRef  String?        // Paystack / Flutterwave Reference
}