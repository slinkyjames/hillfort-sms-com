# Stage 1: Build stage
FROM node:20-alpine AS builder

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy root monorepo configuration files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./

# Copy packages and the web-admin app source code
COPY packages ./packages
COPY apps/web-admin ./apps/web-admin

# Install dependencies across the monorepo workspace
RUN pnpm install --frozen-lockfile

# Build the web-admin application
RUN pnpm --filter @sms/web-admin build

# Stage 2: Production server using Nginx
FROM nginx:alpine

# Copy built assets from the builder stage to Nginx's public directory
COPY --from=builder /app/apps/web-admin/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]