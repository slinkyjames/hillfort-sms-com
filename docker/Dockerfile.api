# Stage 1: Build stage
FROM node:20-alpine AS builder

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy root monorepo configuration files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./

# Copy shared packages and backend API source code
COPY packages ./packages
COPY apps/api ./apps/api

# Install dependencies across the monorepo workspace
RUN pnpm install --frozen-lockfile

# Generate Prisma client and build the API application
RUN pnpm --filter @sms/database db:generate
RUN pnpm --filter @sms/api build

# Stage 2: Production runtime stage
FROM node:20-alpine AS runner

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

ENV NODE_ENV=production
PORT=5000

# Copy workspace metadata files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./

# Copy compiled build output, Prisma client, and package descriptors
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/packages/database ./packages/database

# Install production-only dependencies
RUN pnpm install --prod --frozen-lockfile

EXPOSE 5000

# Start the Express API server
CMD ["pnpm", "--filter", "@sms/api", "start"]